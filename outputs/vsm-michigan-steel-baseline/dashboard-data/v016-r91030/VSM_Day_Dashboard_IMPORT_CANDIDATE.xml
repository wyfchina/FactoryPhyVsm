<?xml version='1.0' encoding='utf-8'?>
<Dashboard CurrencyCulture="zh-CN">
  <Title Text="VSM 库存与到期欠交 · 累计有效工作日 · 单复制结果" />
  <DataSources>
    <DataSource ComponentName="dataSource1" Name="Table.VSM_Out_DashboardPeriods" />
  </DataSources>
  <Items>
    <Chart ComponentName="inventory" Name="平均成品与制造WIP（件）" DataSource="dataSource1" FilterString="[filterPeriod] = 'Day' And [complete] = 1 And [product] = 'Total'">
      <DataItems>
        <Dimension DataMember="PeriodIndex" Name="argument" />
        <Dimension DataMember="PeriodType" Name="filterPeriod" />
        <Dimension DataMember="Product" Name="product" />
        <Dimension DataMember="PeriodComplete" Name="complete" />
        <Measure DataMember="AverageFGUnits" Name="value0" SummaryType="Sum">
          <NumericFormat FormatType="Number" Precision="0" IncludeGroupSeparator="true" />
        </Measure>
        <Measure DataMember="AverageManufacturingWIP" Name="value1" SummaryType="Sum">
          <NumericFormat FormatType="Number" Precision="0" IncludeGroupSeparator="true" />
        </Measure>
      </DataItems>
      <Arguments>
        <Argument Name="argument" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <AxisY Title="工件件数" />
          <Series>
            <Simple SeriesType="Line">
              <Value Name="value0" />
            </Simple>
            <Simple SeriesType="Line">
              <Value Name="value1" />
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <AxisX Title="累计有效工作日" />
      <Names>
        <Name Value="value0" Name="平均成品" />
        <Name Value="value1" Name="平均制造WIP" />
      </Names>
    </Chart>
    <Chart ComponentName="shortfall" Name="到期数量欠交率（0–100%）" DataSource="dataSource1" FilterString="[filterPeriod] = 'Day' And [complete] = 1 And [product] &lt;&gt; 'Total'">
      <DataItems>
        <Dimension DataMember="PeriodIndex" Name="argument" />
        <Dimension DataMember="PeriodType" Name="filterPeriod" />
        <Dimension DataMember="Product" Name="product" />
        <Dimension DataMember="PeriodComplete" Name="complete" />
        <Measure DataMember="DueShortfallRate" Name="value0" SummaryType="Sum">
          <NumericFormat FormatType="Percent" Precision="1" IncludeGroupSeparator="true" />
        </Measure>
      </DataItems>
      <SeriesDimensions>
        <SeriesDimension Name="product" />
      </SeriesDimensions>
      <Arguments>
        <Argument Name="argument" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <AxisY Title="到期数量欠交率" />
          <Series>
            <Simple SeriesType="Line">
              <Value Name="value0" />
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <AxisX Title="累计有效工作日" />
      <Names>
        <Name Value="value0" Name="到期数量欠交率" />
      </Names>
    </Chart>
    <Chart ComponentName="delivery" Name="到期需求满足情况（每根柱合计920件/日）" DataSource="dataSource1" FilterString="[filterPeriod] = 'Day' And [complete] = 1 And [product] = 'Total'">
      <DataItems>
        <Dimension DataMember="PeriodIndex" Name="argument" />
        <Dimension DataMember="PeriodType" Name="filterPeriod" />
        <Dimension DataMember="Product" Name="product" />
        <Dimension DataMember="PeriodComplete" Name="complete" />
        <Measure DataMember="OnTimeUnits" Name="value0" SummaryType="Sum">
          <NumericFormat FormatType="Number" Precision="0" IncludeGroupSeparator="true" />
        </Measure>
        <Measure DataMember="MissedAtDueUnits" Name="value1" SummaryType="Sum">
          <NumericFormat FormatType="Number" Precision="0" IncludeGroupSeparator="true" />
        </Measure>
      </DataItems>
      <Arguments>
        <Argument Name="argument" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <AxisY Title="工件件数" />
          <Series>
            <Simple SeriesType="StackedBar">
              <Value Name="value0" />
            </Simple>
            <Simple SeriesType="StackedBar">
              <Value Name="value1" />
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <AxisX Title="累计有效工作日" />
      <Names>
        <Name Value="value0" Name="准时满足" />
        <Name Value="value1" Name="到期未交" />
      </Names>
    </Chart>
    <Chart ComponentName="backlog" Name="期末欠交余额（件）" DataSource="dataSource1" FilterString="[filterPeriod] = 'Day' And [complete] = 1 And [product] &lt;&gt; 'Total'">
      <DataItems>
        <Dimension DataMember="PeriodIndex" Name="argument" />
        <Dimension DataMember="PeriodType" Name="filterPeriod" />
        <Dimension DataMember="Product" Name="product" />
        <Dimension DataMember="PeriodComplete" Name="complete" />
        <Measure DataMember="ClosingBacklog" Name="value0" SummaryType="Sum">
          <NumericFormat FormatType="Number" Precision="0" IncludeGroupSeparator="true" />
        </Measure>
      </DataItems>
      <SeriesDimensions>
        <SeriesDimension Name="product" />
      </SeriesDimensions>
      <Arguments>
        <Argument Name="argument" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <AxisY Title="工件件数" />
          <Series>
            <Simple SeriesType="Line">
              <Value Name="value0" />
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <AxisX Title="累计有效工作日" />
      <Names>
        <Name Value="value0" Name="期末欠交" />
      </Names>
    </Chart>
  </Items>
  <LayoutTree>
    <LayoutGroup Orientation="Vertical">
      <LayoutItem DashboardItem="inventory" Weight="30" />
      <LayoutItem DashboardItem="shortfall" Weight="24" />
      <LayoutItem DashboardItem="delivery" Weight="24" />
      <LayoutItem DashboardItem="backlog" Weight="22" />
    </LayoutGroup>
  </LayoutTree>
</Dashboard>